{
  "name": "agent-fun-0g",
  "version": "0.1.0",
  "private": true,
  "description": "Launch, own, use, and trade AI agents powered by the full 0G stack.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test:contracts",
    "test:contracts": "forge test --root contracts",
    "deploy:contract": "forge create contracts/src/AgentFunCore.sol:AgentFunCore --rpc-url https://evmrpc.0g.ai --private-key $DEPLOYER_PRIVATE_KEY --broadcast",
    "deploy:mainnet": "forge build --root contracts && tsx scripts/deploy-mainnet.ts",
    "seed:mainnet": "tsx scripts/seed-mainnet-agents.ts",
    "da:submit": "tsx scripts/da-submit.ts",
    "agent:demo": "tsx agents/memory-agent.ts",
    "agents:smoke": "tsx scripts/five-agent-smoke.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.8.1",
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@0gfoundation/0g-ts-sdk": "^1.2.6",
    "ethers": "6.13.1",
    "next": "^16.2.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
